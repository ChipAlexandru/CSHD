---
const links = [
  { href: '/human-design/', label: 'Human Design' },
  { href: '/branding-consultancy/', label: 'Branding Consultancy' },
  { href: '/human-design-faq/', label: 'FAQ' },
];
---

<header class="site-header">
  <div class="container nav-inner">
    <a href="/" class="brand">Christina Siciliani</a>
    <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav" aria-label="Toggle menu">
      <span></span><span></span><span></span>
    </button>
    <nav id="site-nav" class="site-nav">
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid #eee;
    position: sticky;
    top: 0;
    background: var(--color-bg);
    z-index: 10;
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1rem;
    gap: 2rem;
  }
  .brand {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 1.25rem;
    text-decoration: none;
    letter-spacing: 0.02em;
  }
  .site-nav ul {
    display: flex;
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.9rem;
    letter-spacing: 0.04em;
  }
  .site-nav a {
    text-decoration: none;
  }
  .nav-toggle {
    display: none;
    background: none;
    border: 0;
    padding: 0.5rem;
    gap: 4px;
    flex-direction: column;
  }
  .nav-toggle span {
    display: block;
    width: 24px;
    height: 1.5px;
    background: currentColor;
  }
  @media (max-width: 768px) {
    .nav-toggle { display: flex; }
    .site-nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--color-bg);
      border-bottom: 1px solid #eee;
      display: none;
    }
    .site-nav[data-open="true"] { display: block; }
    .site-nav ul {
      flex-direction: column;
      gap: 0;
      padding: 1rem 2rem;
    }
    .site-nav li {
      padding-block: 0.75rem;
      border-bottom: 1px solid #eee;
    }
    .site-nav li:last-child { border-bottom: 0; }
  }
</style>

<script>
  const btn = document.querySelector('.nav-toggle');
  const nav = document.getElementById('site-nav');
  btn?.addEventListener('click', () => {
    const open = nav?.getAttribute('data-open') === 'true';
    nav?.setAttribute('data-open', String(!open));
    btn.setAttribute('aria-expanded', String(!open));
  });
</script>
